# LLM Evaluator Environment Configuration

# Application Settings
APP_NAME="LLM Evaluator"
DEBUG=false
HOST=0.0.0.0
PORT=7500

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./llm_eval.db

# LLM Provider API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Evaluation Settings
MAX_CONCURRENT_TESTS=5
DEFAULT_TIMEOUT=30
CACHE_RESULTS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json